+    for (int col = threadIdx.x; col < ne0; col += (int) blockDim.x) {
+        const float t0 = a[off + col] + bias[col];
+        d_add[off + col] = t0;
+
+        const float t1 = op(t0);
+        d_un[off + col] = t1;
+
+        d_mul[off + col] = t1 * scale[col];
