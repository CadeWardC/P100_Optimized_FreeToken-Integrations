+        CUDA_TOP_K_LAUNCH2(2);
+        CUDA_TOP_K_LAUNCH2(4);
+        CUDA_TOP_K_LAUNCH2(8);
+        CUDA_TOP_K_LAUNCH2(16);
+        default: return false;
+    }
+#undef CUDA_TOP_K_LAUNCH2
