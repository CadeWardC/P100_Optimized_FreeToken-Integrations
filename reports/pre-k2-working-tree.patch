+    cpy_fused_ptrs p = {};
+    for (int k = 0; k < n; ++k) {
+        p.cx[k]   = (const char *) nodes[k]->src[0]->data;
+        p.cdst[k] = (char *)       nodes[k]->src[1]->data;
+    }
