+// (stage 1: 22.5 -> 11.3 us).
+static __device__ __forceinline__ uint64_t top_k_pack(const uint32_t k32, const int i32) {
+    return ((uint64_t) k32 << 32) | (uint32_t) ~(uint32_t) i32;
