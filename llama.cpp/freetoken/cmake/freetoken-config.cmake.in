@PACKAGE_INIT@
set_and_check(FREETOKEN_INCLUDE_DIR "@PACKAGE_FREETOKEN_INCLUDE_INSTALL_DIR@")
set_and_check(FREETOKEN_LIB_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
include(CMakeFindDependencyMacro)
find_dependency(ggml CONFIG)
find_dependency(Threads)
if (NOT TARGET freetoken::runtime)
    find_library(FREETOKEN_RUNTIME_LIBRARY freetoken-runtime HINTS "${FREETOKEN_LIB_DIR}" NO_DEFAULT_PATH)
    if (NOT FREETOKEN_RUNTIME_LIBRARY)
        set(freetoken_FOUND FALSE)
        set(freetoken_NOT_FOUND_MESSAGE "FreeToken runtime library is missing")
        return()
    endif()
    add_library(freetoken::runtime STATIC IMPORTED)
    set_target_properties(freetoken::runtime PROPERTIES
        IMPORTED_LOCATION "${FREETOKEN_RUNTIME_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${FREETOKEN_INCLUDE_DIR}"
        INTERFACE_COMPILE_FEATURES cxx_std_17
        INTERFACE_LINK_LIBRARIES "ggml::ggml;ggml::ggml-cpu;Threads::Threads")
endif()
check_required_components(freetoken)
